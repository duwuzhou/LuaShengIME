<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
              android:layout_width="match_parent"
              android:layout_height="wrap_content"
              android:gravity="center_horizontal"
              android:orientation="vertical">

    <Keyboard
            android:horizontalGap="0%p"
            android:keyHeight="56dp"
            android:verticalGap="5dp">

        <!-- 第一行：10个键 -->
        <Row android:keyWidth="9.9%p">
            <Key android:codes="113" android:keyLabel="q" android:popupCharacters="1"/>
            <Key android:codes="119" android:keyLabel="w" android:popupCharacters="2"/>
            <Key android:codes="101" android:keyLabel="e" android:popupCharacters="3,ê,é,è"/>
            <Key android:codes="114" android:keyLabel="r" android:popupCharacters="4"/>
            <Key android:codes="116" android:keyLabel="t" android:popupCharacters="5"/>
            <Key android:codes="121" android:keyLabel="y" android:popupCharacters="6"/>
            <Key android:codes="117" android:keyLabel="u" android:popupCharacters="7,û,ü,ǔ"/>
            <Key android:codes="105" android:keyLabel="i" android:popupCharacters="8,ī,í,ì"/>
            <Key android:codes="111" android:keyLabel="o" android:popupCharacters="9,ō,ó,ò"/>
            <Key android:codes="112" android:keyLabel="p" android:popupCharacters="0"/>
        </Row>

        <!-- 第二行：9个键 -->
        <Row android:keyWidth="9.9%p">
            <Key android:codes="97" android:keyLabel="a" android:popupCharacters="ā,á,ǎ,à"/>
            <Key android:codes="115" android:keyLabel="s" android:popupCharacters="š"/>
            <Key android:codes="100" android:keyLabel="d"/>
            <Key android:codes="102" android:keyLabel="f"/>
            <Key android:codes="103" android:keyLabel="g"/>
            <Key android:codes="104" android:keyLabel="h"/>
            <Key android:codes="106" android:keyLabel="j"/>
            <Key android:codes="107" android:keyLabel="k"/>
            <Key android:codes="108" android:keyLabel="l"/>
        </Row>

        <!-- 第三行：9个键（含功能键） -->
        <Row android:keyWidth="9.8%p">
            <Key android:codes="-1" android:keyLabel="⇧" android:keyWidth="15%p"/>
            <Key android:codes="122" android:keyLabel="z"/>
            <Key android:codes="120" android:keyLabel="x"/>
            <Key android:codes="99" android:keyLabel="c" android:popupCharacters="č,ć"/>
            <Key android:codes="118" android:keyLabel="v"/>
            <Key android:codes="98" android:keyLabel="b"/>
            <Key android:codes="110" android:keyLabel="n"/>
            <Key android:codes="109" android:keyLabel="m"/>
            <Key android:codes="-5" android:keyLabel="⌫" android:keyWidth="15%p"/>
        </Row>

        <!-- 第四行：7个键（功能键行） -->
        <Row android:keyWidth="14.8%p">
            <Key android:codes="-2" android:keyLabel="123" />
            <Key android:codes="-6" android:keyLabel="符" />
            <Key android:codes="44" android:keyLabel="，" android:keyWidth="10%p"/>
            <Key android:codes="32" android:keyLabel="空格" android:keyWidth="20%p"/>
            <Key android:codes="46" android:keyLabel="。" android:keyWidth="10%p"/>
            <Key android:codes="-4" android:keyLabel="中/英"/>
            <Key android:codes="-3" android:keyLabel="↵"/>
        </Row>
    </Keyboard>
</LinearLayout>
