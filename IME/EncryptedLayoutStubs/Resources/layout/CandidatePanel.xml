<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:id="@+id/candidatePanelRoot"
    android:orientation="vertical">
        <LinearLayout
            android:id="@+id/candidatePanelRoot"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:visibility="gone" />
        <LinearLayout
            android:id="@+id/panelHeader"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:visibility="gone" />
        <TextView
            android:id="@+id/panelTitle"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:visibility="gone" />
        <Button
            android:id="@+id/btnPanelClose"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:visibility="gone" />
        <LinearLayout
            android:id="@+id/panelPreviewContainer"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:visibility="gone" />
        <TextView
            android:id="@+id/panelInputPreviewText"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:visibility="gone" />
        <TextView
            android:id="@+id/panelCandidatePreviewText"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:visibility="gone" />
        <ScrollView
            android:id="@+id/panelScrollView"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:visibility="gone" />
        <LinearLayout
            android:id="@+id/panelListContainer"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:visibility="gone" />
</LinearLayout>