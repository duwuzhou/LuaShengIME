<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
              android:layout_width="match_parent"
              android:layout_height="wrap_content"
              android:gravity="center_horizontal"
              android:orientation="vertical">

    <Keyboard
            android:horizontalGap="0.5%p"
            android:keyHeight="56dp"
            android:verticalGap="5dp">

        <!-- 第一行：8个键 -->
        <Row android:keyWidth="12.3%p">
            <Key android:codes="49" android:keyLabel="1"/>
            <Key android:codes="50" android:keyLabel="2"/>
            <Key android:codes="51" android:keyLabel="3"/>
            <Key android:codes="43" android:keyLabel="+"/>
            <Key android:codes="45" android:keyLabel="-"/>
            <Key android:codes="215" android:keyLabel="×"/>
            <Key android:codes="247" android:keyLabel="÷"/>
            <Key android:codes="61" android:keyLabel="="/>
        </Row>

        <!-- 第二行：8个键 -->
        <Row android:keyWidth="12.3%p">
            <Key android:codes="52" android:keyLabel="4"/>
            <Key android:codes="53" android:keyLabel="5"/>
            <Key android:codes="54" android:keyLabel="6"/>
            <Key android:codes="40" android:keyLabel="("/>
            <Key android:codes="41" android:keyLabel=")"/>
            <Key android:codes="91" android:keyLabel="["/>
            <Key android:codes="93" android:keyLabel="]"/>
            <Key android:codes="37" android:keyLabel="%"/>
        </Row>

        <!-- 第三行：8个键 -->
        <Row android:keyWidth="12.3%p">
            <Key android:codes="55" android:keyLabel="7"/>
            <Key android:codes="56" android:keyLabel="8"/>
            <Key android:codes="57" android:keyLabel="9"/>
            <Key android:codes="48" android:keyLabel="0"/>
            <Key android:codes="46" android:keyLabel="."/>
            <Key android:codes="44" android:keyLabel=","/>
            <Key android:codes="-7" android:keyLabel="ABC"/>
            <Key android:codes="-5" android:keyLabel="⌫"/>
        </Row>

        <!-- 第四行：3个键（功能键行） -->
        <Row android:keyWidth="25%p">
            <Key android:codes="-6" android:keyLabel="符"/>
            <Key android:codes="32" android:keyLabel="空格" android:keyWidth="50%p"/>
            <Key android:codes="-3" android:keyLabel="↵"/>
        </Row>
    </Keyboard>
</LinearLayout>
