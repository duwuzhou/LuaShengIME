<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="@dimen/spacing_lg">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="输入法设置"
            android:textSize="@dimen/text_title"
            android:textStyle="bold"
            android:textColor="@color/text_primary"
            android:gravity="center"
            android:paddingBottom="@dimen/spacing_lg" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/bg_card"
            android:padding="@dimen/spacing_lg"
            android:layout_marginBottom="@dimen/spacing_md">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="输入方案"
                android:textSize="@dimen/text_subtitle"
                android:textColor="@color/text_primary"
                android:paddingBottom="@dimen/spacing_sm" />

            <Spinner
                android:id="@+id/spinner_schema"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:background="@drawable/bg_field"
                android:spinnerMode="dropdown" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:background="@drawable/bg_card"
            android:padding="@dimen/spacing_lg"
            android:layout_marginBottom="@dimen/spacing_md"
            android:gravity="center_vertical">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="按键振动"
                    android:textSize="@dimen/text_subtitle"
                    android:textColor="@color/text_primary" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="按键时提供振动反馈"
                    android:textSize="@dimen/text_caption"
                    android:textColor="@color/text_secondary" />
            </LinearLayout>

            <com.google.android.material.switchmaterial.SwitchMaterial
                android:id="@+id/switch_vibrate"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:background="@drawable/bg_card"
            android:padding="@dimen/spacing_lg"
            android:layout_marginBottom="@dimen/spacing_md"
            android:gravity="center_vertical">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="按键音效"
                    android:textSize="@dimen/text_subtitle"
                    android:textColor="@color/text_primary" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="按键时播放音效"
                    android:textSize="@dimen/text_caption"
                    android:textColor="@color/text_secondary" />
            </LinearLayout>

            <com.google.android.material.switchmaterial.SwitchMaterial
                android:id="@+id/switch_sound"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:background="@drawable/bg_card"
            android:padding="@dimen/spacing_lg"
            android:layout_marginBottom="@dimen/spacing_md"
            android:gravity="center_vertical">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="简体输出"
                    android:textSize="@dimen/text_subtitle"
                    android:textColor="@color/text_primary" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="开启后输出简体字，关闭后输出繁体字"
                    android:textSize="@dimen/text_caption"
                    android:textColor="@color/text_secondary" />
            </LinearLayout>

            <com.google.android.material.switchmaterial.SwitchMaterial
                android:id="@+id/switch_simplification"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/bg_card"
            android:padding="@dimen/spacing_lg"
            android:layout_marginBottom="@dimen/spacing_md">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="候选设置"
                android:textSize="@dimen/text_subtitle"
                android:textColor="@color/text_primary"
                android:paddingBottom="@dimen/spacing_sm" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="每页候选数量"
                android:textSize="@dimen/text_body"
                android:textColor="@color/text_secondary"
                android:paddingBottom="@dimen/spacing_sm" />

            <Spinner
                android:id="@+id/spinner_candidate_page_size"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:background="@drawable/bg_field"
                android:spinnerMode="dropdown"
                android:layout_marginBottom="@dimen/spacing_sm" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/settings_backspace_long_press_delay_label"
                android:textSize="@dimen/text_body"
                android:textColor="@color/text_secondary"
                android:paddingBottom="@dimen/spacing_sm" />

            <Spinner
                android:id="@+id/spinner_backspace_long_press_delay"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:background="@drawable/bg_field"
                android:spinnerMode="dropdown"
                android:layout_marginBottom="@dimen/spacing_sm" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/settings_tap_fallback_label"
                android:textSize="@dimen/text_body"
                android:textColor="@color/text_secondary"
                android:paddingBottom="@dimen/spacing_sm" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginBottom="@dimen/spacing_sm">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/settings_tap_fallback_duration_label"
                        android:textSize="@dimen/text_caption"
                        android:textColor="@color/text_secondary"
                        android:paddingBottom="@dimen/spacing_xs" />

                    <EditText
                        android:id="@+id/edit_tap_fallback_duration_ms"
                        android:layout_width="match_parent"
                        android:layout_height="48dp"
                        android:background="@drawable/bg_field"
                        android:inputType="number"
                        android:paddingStart="@dimen/spacing_md"
                        android:paddingEnd="@dimen/spacing_md" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:layout_marginStart="@dimen/spacing_sm">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/settings_tap_fallback_move_slop_label"
                        android:textSize="@dimen/text_caption"
                        android:textColor="@color/text_secondary"
                        android:paddingBottom="@dimen/spacing_xs" />

                    <EditText
                        android:id="@+id/edit_tap_fallback_move_slop_dp"
                        android:layout_width="match_parent"
                        android:layout_height="48dp"
                        android:background="@drawable/bg_field"
                        android:inputType="number"
                        android:paddingStart="@dimen/spacing_md"
                        android:paddingEnd="@dimen/spacing_md" />
                </LinearLayout>
            </LinearLayout>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_reset_tap_fallback"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:text="@string/settings_tap_fallback_reset" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/settings_enter_action_label"
                android:textSize="@dimen/text_body"
                android:textColor="@color/text_secondary"
                android:paddingBottom="@dimen/spacing_sm" />

            <Spinner
                android:id="@+id/spinner_enter_action"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:background="@drawable/bg_field"
                android:spinnerMode="dropdown"
                android:layout_marginBottom="@dimen/spacing_sm" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="候选预览"
                        android:textSize="@dimen/text_subtitle"
                        android:textColor="@color/text_primary" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="在候选栏显示预览"
                        android:textSize="@dimen/text_caption"
                        android:textColor="@color/text_secondary" />
                </LinearLayout>

                <com.google.android.material.switchmaterial.SwitchMaterial
                    android:id="@+id/switch_candidate_preview"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content" />
            </LinearLayout>
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/bg_card"
            android:padding="@dimen/spacing_lg"
            android:layout_marginBottom="@dimen/spacing_md">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="词预测"
                android:textSize="@dimen/text_subtitle"
                android:textColor="@color/text_primary"
                android:paddingBottom="@dimen/spacing_sm" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="@dimen/spacing_sm">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="开启词预测"
                        android:textSize="@dimen/text_subtitle"
                        android:textColor="@color/text_primary" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="上屏后显示下一词预测"
                        android:textSize="@dimen/text_caption"
                        android:textColor="@color/text_secondary" />
                </LinearLayout>

                <com.google.android.material.switchmaterial.SwitchMaterial
                    android:id="@+id/switch_prediction_enabled"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="@dimen/spacing_sm">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="始终预测"
                        android:textSize="@dimen/text_subtitle"
                        android:textColor="@color/text_primary" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="选中预测词后继续预测"
                        android:textSize="@dimen/text_caption"
                        android:textColor="@color/text_secondary" />
                </LinearLayout>

                <com.google.android.material.switchmaterial.SwitchMaterial
                    android:id="@+id/switch_prediction_always"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content" />
            </LinearLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="预测次数"
                android:textSize="@dimen/text_body"
                android:textColor="@color/text_secondary"
                android:paddingBottom="@dimen/spacing_sm" />

            <Spinner
                android:id="@+id/spinner_prediction_rounds"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:background="@drawable/bg_field"
                android:spinnerMode="dropdown"
                android:layout_marginBottom="@dimen/spacing_sm" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_prediction_manage"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:text="管理预测词" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_shortcut_manage"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="@dimen/spacing_sm"
                android:text="管理快捷短语" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/bg_card"
            android:padding="@dimen/spacing_lg"
            android:layout_marginBottom="@dimen/spacing_md">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="主题"
                android:textSize="@dimen/text_subtitle"
                android:textColor="@color/text_primary"
                android:paddingBottom="@dimen/spacing_sm" />

            <Spinner
                android:id="@+id/spinner_theme"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:background="@drawable/bg_field"
                android:spinnerMode="dropdown" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/bg_card"
            android:padding="@dimen/spacing_lg"
            android:layout_marginBottom="@dimen/spacing_md">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/settings_simulated_typing_title"
                android:textSize="@dimen/text_subtitle"
                android:textColor="@color/text_primary"
                android:paddingBottom="@dimen/spacing_xs" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/settings_simulated_typing_hint"
                android:textSize="@dimen/text_caption"
                android:textColor="@color/text_secondary"
                android:paddingBottom="@dimen/spacing_sm" />

            <EditText
                android:id="@+id/edit_simulated_typing_text"
                android:layout_width="match_parent"
                android:layout_height="120dp"
                android:background="@drawable/bg_field"
                android:gravity="top|start"
                android:hint="@string/settings_simulated_typing_input_hint"
                android:inputType="textMultiLine|textCapSentences"
                android:minLines="4"
                android:padding="@dimen/spacing_md"
                android:scrollbars="vertical" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_sm"
                android:text="@string/settings_simulated_typing_speed_label"
                android:textSize="@dimen/text_body"
                android:textColor="@color/text_secondary"
                android:paddingBottom="@dimen/spacing_sm" />

            <Spinner
                android:id="@+id/spinner_simulated_typing_speed"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:background="@drawable/bg_field"
                android:spinnerMode="dropdown" />
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginTop="@dimen/spacing_sm">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_save_simulated_typing_text"
                    android:layout_width="0dp"
                    android:layout_height="48dp"
                    android:layout_weight="1"
                    android:text="@string/settings_simulated_typing_save" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_clear_simulated_typing_text"
                    android:layout_width="0dp"
                    android:layout_height="48dp"
                    android:layout_weight="1"
                    android:layout_marginStart="@dimen/spacing_sm"
                    android:text="@string/settings_simulated_typing_clear" />
            </LinearLayout>
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/bg_card"
            android:padding="@dimen/spacing_lg"
            android:layout_marginBottom="@dimen/spacing_md">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="维护"
                android:textSize="@dimen/text_subtitle"
                android:textColor="@color/text_primary"
                android:paddingBottom="@dimen/spacing_sm" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_sync_user_data"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:text="同步用户词库"
                android:layout_marginBottom="@dimen/spacing_sm" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_redeploy"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:text="重新部署 Rime"
                android:layout_marginBottom="@dimen/spacing_sm" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_import_lexicon"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:text="导入用户词库"
                android:layout_marginBottom="@dimen/spacing_sm" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_export_dict"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:text="导出用户词库" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/bg_card"
            android:padding="@dimen/spacing_lg"
            android:layout_marginBottom="@dimen/spacing_md">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="关于"
                android:textSize="@dimen/text_subtitle"
                android:textColor="@color/text_primary"
                android:paddingBottom="@dimen/spacing_sm" />

            <TextView
                android:id="@+id/tv_rime_version"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Rime 版本: --"
                android:textSize="@dimen/text_body"
                android:textColor="@color/text_secondary"
                android:paddingBottom="@dimen/spacing_xs" />

            <TextView
                android:id="@+id/tv_app_version"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="应用版本: --"
                android:textSize="@dimen/text_body"
                android:textColor="@color/text_secondary" />
        </LinearLayout>

    </LinearLayout>
</ScrollView>
