<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical">

    <LinearLayout
        android:id="@+id/inputPreviewContainer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="52dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:visibility="gone">

        <TextView
            android:id="@+id/inputPreviewText"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1" />

        <TextView
            android:id="@+id/candidatePreviewText"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="end" />

        <Button
            android:id="@+id/btnPinyinEditBack"
            android:layout_width="80dp"
            android:layout_height="wrap_content"
            android:visibility="gone"
            android:text="&#x53D6;&#x6D88;" />
    </LinearLayout>

    <FrameLayout
        android:id="@+id/candidateContentContainer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="52dp">

        <LinearLayout
            android:id="@+id/candidateRow"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:visibility="gone">

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/candidateRecyclerView"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:minHeight="52dp"
                android:layout_weight="1" />

            <Button
                android:id="@+id/btn_candidate_more"
                android:layout_width="80dp"
                android:layout_height="40dp"
                android:minHeight="40dp"
                android:text="&#x66F4;&#x591A;" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/functionButtonsContainer"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:visibility="visible">

            <Button
                android:id="@+id/switchButton1"
                android:layout_width="80dp"
                android:layout_height="40dp"
                android:text="&#x952E;&#x76D8;" />

            <Button
                android:id="@+id/switchButton2"
                android:layout_width="80dp"
                android:layout_height="40dp"
                android:text="&#x529F;&#x80FD;" />
        </LinearLayout>
    </FrameLayout>

</LinearLayout>
